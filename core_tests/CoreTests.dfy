include "../core/Core.dfy"

module CoreTests {
  import opened C = Core
  method Main() {
    expect !ValidRelative("");
    expect !ValidRelative("/etc/passwd");
    expect !ValidRelative("a/../b");
    expect !ValidRelative("a//b");
    expect !ValidRelative("a/./b");
    expect !ValidRelative("a\\b");
    expect !ValidRelative("a\0b");
    expect ValidRelative("docs/report.pdf");
    expect ValidRelative("a..b");
    expect ClampLimit(-3, 100) == 1;
    expect ClampLimit(200, 100) == 100;
    expect ClampLimit(7, 100) == 7;
    expect RankScore(0, 0) == 0;
    expect RankScore(1, 1) > RankScore(2, 2);
    expect !ShouldReplace("same", "same");
    expect ShouldReplace("old", "new");
    expect IndexedFingerprint("abc", false) == "abc";
    expect IndexedFingerprint("abc", true) == "abc;clip";
    expect ContentHash("abc;clip") == "abc";
    expect ContentHash("abc") == "abc";
    expect CanSkipUnchanged("1:2", "1:2", "abc", false);
    expect CanSkipUnchanged("1:2", "1:2", "abc;clip", true);
    expect !CanSkipUnchanged("", "", "abc", false);
    expect !CanSkipUnchanged("1:2", "1:3", "abc", false);
    expect !CanSkipUnchanged("1:2", "1:2", "abc", true);
    expect !CanSkipUnchanged("1:2", "1:2", "abc;clip", false);
    expect Chunk("", 4, 1) == [];
    expect Chunk("abcdef", 4, 1) == ["abcd", "def"];
    expect Chunk("abc", 4, 0) == ["abc"];
    expect Chunk("abcdefgh", 4, 0) == ["abcd", "efgh"];
    expect SortTop([(3, 10), (2, 20), (1, 20)], 2) == [(1, 20), (2, 20)];
    expect SortTop([(3, 10)], 0) == [];
    expect SortTop([(3, 10)], 5) == [(3, 10)];
    expect MatchesTerms("week 10/notes [a].pdf", ["notes", "week 10"]);
    expect MatchesTerms("week 10/notes [a].pdf", ["[a].", ".pdf"]);
    expect !MatchesTerms("week 10/notes [a].pdf", ["notes", "absent"]);
    expect !MatchesTerms("week 10/notes [a].pdf", [".*"]);
    expect MatchesTerms("中文🎵/notes", ["🎵", "中文"]);
    expect MatchesTerms("", []);
    expect MatchesTerms("anything", [""]);
    expect !MatchesTerms("abc", ["abcd"]);
    expect ShowInline("application/pdf");
    expect ShowInline("image/jpeg");
    expect ShowInline("image/png");
    expect ShowInline("text/plain");
    expect !ShowInline("text/html");
    expect !ShowInline("image/svg+xml");
    expect !ShowInline("application/octet-stream");
    expect !ShowInline("");
    expect LinkActive(100, 101);
    expect !LinkActive(101, 101);
    expect !LinkActive(102, 101);
    expect !LoginAttemptAllowed(-1);
    expect LoginAttemptAllowed(0);
    expect LoginAttemptAllowed(4);
    expect !LoginAttemptAllowed(5);
    expect !LoginAttemptAllowed(6);
    expect FailedLoginCount(0) == 1;
    expect FailedLoginCount(4) == 5;
    expect ValidPhotoPage(0, 1);
    expect ValidPhotoPage(100000, 100);
    expect ValidPhotoPage(20, 20);
    expect !ValidPhotoPage(-1, 20);
    expect !ValidPhotoPage(100001, 20);
    expect !ValidPhotoPage(0, 0);
    expect !ValidPhotoPage(0, 101);
    expect ValidPhotoPerson(1);
    expect ValidPhotoPerson(3753);
    expect ValidPhotoPerson(2147483647);
    expect !ValidPhotoPerson(0);
    expect !ValidPhotoPerson(-1);
    expect !ValidPhotoPerson(2147483648);
    expect !SynologyPhotosAllowed(false, ["Photos"], []);
    expect !SynologyPhotosAllowed(true, [], []);
    expect !SynologyPhotosAllowed(true, ["Photos/Family"], []);
    expect !SynologyPhotosAllowed(true, ["Photos2"], []);
    expect SynologyPhotosAllowed(true, ["Photos"], []);
    expect SynologyPhotosAllowed(true, ["Photos", "Code"], ["Code", "Photos2"]);
    expect !SynologyPhotosAllowed(true, ["Photos"], ["Photos"]);
    expect !SynologyPhotosAllowed(true, ["Photos"], ["Photos/Private"]);
    expect !SynologyPhotosAllowed(true, ["Photos"], ["Photos/"]);
    expect ValidOAuthRegistration(1, true, true, true, true, true);
    expect ValidOAuthRegistration(4, true, true, true, true, true);
    expect !ValidOAuthRegistration(0, true, true, true, true, true);
    expect !ValidOAuthRegistration(5, true, true, true, true, true);
    expect !ValidOAuthRegistration(1, false, true, true, true, true);
    expect !ValidOAuthRegistration(1, true, false, true, true, true);
    expect !ValidOAuthRegistration(1, true, true, false, true, true);
    expect !ValidOAuthRegistration(1, true, true, true, false, true);
    expect !ValidOAuthRegistration(1, true, true, true, true, false);
    expect CanRegisterOAuthClient(0, 1);
    expect CanRegisterOAuthClient(127, 128);
    expect !CanRegisterOAuthClient(-1, 128);
    expect !CanRegisterOAuthClient(128, 128);
    expect !CanRegisterOAuthClient(0, 0);
    expect !CanRegisterOAuthClient(0, 129);
    // Shared memory: scopes never leak across boundaries.
    expect ValidScope("personal");
    expect ValidScope("work/acme");
    expect ValidScope("personal/projects/nas-search-mcp");
    expect !ValidScope("");
    expect !ValidScope("/personal");
    expect !ValidScope("personal/");
    expect !ValidScope("work//acme");
    expect !ValidScope("Work");
    expect !ValidScope("a b");
    expect ScopeWithin("personal", "personal");
    expect ScopeWithin("personal/projects/x", "personal");
    expect !ScopeWithin("personal2", "personal");
    expect !ScopeWithin("personal", "personal/projects");
    expect !ScopeWithin("work/acme", "personal");
    expect ScopeVisible("work/acme/x", ["personal", "work/acme"]);
    expect !ScopeVisible("work/other", ["personal", "work/acme"]);
    expect !ScopeVisible("personal", []);
    // Memory status: only accepted memories are current; terminal states stay terminal.
    expect IsCurrentMemory("accepted");
    expect !IsCurrentMemory("candidate");
    expect !IsCurrentMemory("retracted");
    expect ValidMemoryTransition("candidate", "accepted");
    expect ValidMemoryTransition("candidate", "rejected");
    expect ValidMemoryTransition("accepted", "superseded");
    expect ValidMemoryTransition("accepted", "retracted");
    expect ValidMemoryTransition("disputed", "accepted");
    expect !ValidMemoryTransition("retracted", "accepted");
    expect !ValidMemoryTransition("superseded", "accepted");
    expect !ValidMemoryTransition("rejected", "accepted");
    expect !ValidMemoryTransition("accepted", "accepted");
    expect !ValidMemoryTransition("candidate", "unknown");
    expect ValidEventType("decision");
    expect ValidEventType("manual_note");
    expect !ValidEventType("chat");
    expect ValidEventStatus("unverified");
    expect !ValidEventStatus("accepted");
    // Checkpoints: optimistic concurrency.
    expect CheckpointWrite(0, 0) == (true, 1);
    expect CheckpointWrite(3, 3) == (true, 4);
    expect CheckpointWrite(3, 2) == (false, 3);
    expect CheckpointWrite(0, 1) == (false, 0);
    // Context packing: keep order, never exceed the budget, skip what does not fit.
    expect PackBudget([3, 4, 5], 10) == [0, 1];
    expect PackBudget([3, 9, 5], 10) == [0, 2];
    expect PackBudget([11, 2], 10) == [1];
    expect PackBudget([], 10) == [];
    expect PackBudget([1, 1], 0) == [];
    // Review routing on per-mille probabilities.
    expect RouteCandidate(950, 900, 100) == "accept";
    expect RouteCandidate(900, 900, 100) == "accept";
    expect RouteCandidate(500, 900, 100) == "review";
    expect RouteCandidate(100, 900, 100) == "reject";
    expect InitialMemoryStatus(true, 0, 900, 100) == "accepted";
    expect InitialMemoryStatus(false, 950, 900, 100) == "accepted";
    expect InitialMemoryStatus(false, 500, 900, 100) == "candidate";
    expect InitialMemoryStatus(false, 50, 900, 100) == "rejected";
    // Passkeys.
    expect !PasskeyRequired("off", 3);
    expect !PasskeyRequired("enroll", 0);
    expect PasskeyRequired("enroll", 1);
    expect PasskeyRequired("required", 0);
    expect PasskeyRequired("bogus", 0);
    expect CanRegisterPasskey(0, 10);
    expect CanRegisterPasskey(9, 10);
    expect !CanRegisterPasskey(10, 10);
    expect !CanRegisterPasskey(0, 0);
    expect PasskeySignCountValid(0, 0);
    expect PasskeySignCountValid(4, 5);
    expect !PasskeySignCountValid(5, 5);
    expect !PasskeySignCountValid(5, 0);
    expect PasskeySignCountValid(0, 7);
    // Editor: only the configured Tailscale owner.
    expect EditorAllowed("matt@example.com", "matt@example.com");
    expect !EditorAllowed("", "");
    expect !EditorAllowed("eve@example.com", "matt@example.com");
    expect RouteCandidate(-1, 900, 100) == "review";
    expect RouteCandidate(1001, 900, 100) == "review";
    expect InitialMemoryStatus(false, -1, 900, 100) == "candidate";
    expect AssistantMayTransition("accepted", "disputed");
    expect AssistantMayTransition("candidate", "disputed");
    expect !AssistantMayTransition("candidate", "accepted");
    expect !AssistantMayTransition("accepted", "retracted");
    expect !AssistantMayTransition("retracted", "disputed");
    expect ProposesMemory("memory");
    expect MemorySaveOutcome("memory", true) == "memory_suggestion";
    expect MemorySaveOutcome("memory", false) == "already_saved";
    expect MemorySaveOutcome("observation", true) == "journal_only";
    expect MemorySaveOutcome("decision", false) == "already_saved";
    expect ValidEventType("memory");
    expect !ProposesMemory("decision");
    expect !ProposesMemory("manual_note");
    expect !ProposesMemory("observation");
    expect !ProposesMemory("correction");
    expect !ProposesMemory("discussion");
    expect !ProposesMemory("checkpoint");
    expect DefaultMemoryCategory("decision") == "decision";
    expect DefaultMemoryCategory("observation") == "fact";
    expect ValidMemoryCategory("lesson");
    expect !ValidMemoryCategory("rumour");
    expect ExternalClassificationAllowed(true, false, "personal/x", ["personal"]);
    expect !ExternalClassificationAllowed(true, true, "personal/x", ["personal"]);
    expect !ExternalClassificationAllowed(false, false, "personal/x", ["personal"]);
    expect !ExternalClassificationAllowed(true, false, "work/acme", ["personal"]);
    expect DefaultEventStatus(true, "decision") == "confirmed";
    expect DefaultEventStatus(false, "exploration") == "proposed";
    expect DefaultEventStatus(false, "decision") == "unverified";
    expect EventStatusAllowed(true, "confirmed");
    expect !EventStatusAllowed(false, "confirmed");
    expect EventStatusAllowed(false, "proposed");
    expect !EventStatusAllowed(true, "accepted");
    expect IsUnconfirmedMemory("candidate");
    expect IsUnconfirmedMemory("disputed");
    expect !IsUnconfirmedMemory("accepted");
    expect ContextBudget(0) == 1500;
    expect ContextBudget(50) == 200;
    expect ContextBudget(9000) == 8000;
    expect ContextBudget(2000) == 2000;
    expect OrphanedAfterForget(["evt_a"], "evt_a");
    expect !OrphanedAfterForget(["evt_a", "evt_b"], "evt_a");
    expect !OrphanedAfterForget([], "evt_a");
    expect !OrphanedAfterForget(["evt_b"], "evt_a");
    expect ValidPasskeyMode("off") && ValidPasskeyMode("enroll") && ValidPasskeyMode("required");
    expect !ValidPasskeyMode("") && !ValidPasskeyMode("Required");
    expect PasskeyStep("off", 3) == "complete";
    expect PasskeyStep("enroll", 0) == "enroll_optional";
    expect PasskeyStep("enroll", 2) == "assert";
    expect PasskeyStep("required", 0) == "enroll_required";
    expect PasskeyStep("required", 1) == "assert";
    expect PasskeyStep("typo", 0) == "enroll_required";
    expect PasskeyRemovalAllowed("enroll", 1);
    expect !PasskeyRemovalAllowed("required", 1);
    expect PasskeyRemovalAllowed("required", 2);
    expect !PasskeyRemovalAllowed("off", 0);
    expect MaySupersede(true, "confirmed");
    expect !MaySupersede(false, "confirmed");
    expect MaySupersede(false, "unverified");
    expect SocketMethodAllowed("AppendEvent");
    expect !SocketMethodAllowed("ForgetEvent");
    expect !SocketMethodAllowed("ForgetMemory");
    expect ValidMemoryStatus("disputed");
    expect !ValidMemoryStatus("deleted");
    expect CorrectionMayCarryStatement("superseded");
    expect !CorrectionMayCarryStatement("disputed");
    expect AssistantMayAppendType("decision");
    expect !AssistantMayAppendType("checkpoint");
    expect !AssistantMayAppendType("chat");
    expect DefaultPasskeyMode(true) == "off";
    expect DefaultPasskeyMode(false) == "enroll";
    expect ScopeWideContextCategory("preference");
    expect !ScopeWideContextCategory("fact");
    expect KeepBackup(0, 7);
    expect KeepBackup(6, 7);
    expect !KeepBackup(7, 7);
    expect !KeepBackup(0, 0);
    expect ValidBackupRetention(1) && ValidBackupRetention(90);
    expect !ValidBackupRetention(0) && !ValidBackupRetention(91);
    expect VacuumAction("start") && VacuumAction("dock") && VacuumAction("clean_rooms");
    expect !VacuumAction("factory_reset") && !VacuumAction("");
    expect VacuumNeedsRooms("clean_rooms") && !VacuumNeedsRooms("start");
    expect ValidVacuumCommand("start", [], [3, 5], 0, -1);
    expect ValidVacuumCommand("dock", [], [], 0, -1);
    expect !ValidVacuumCommand("start", [3], [3, 5], 0, -1);
    expect !ValidVacuumCommand("pause", [], [], 1, -1);
    expect !ValidVacuumCommand("pause", [], [], 0, 2);
    expect !ValidVacuumCommand("self_destruct", [], [], 0, -1);
    expect ValidVacuumCommand("clean_rooms", [3], [3, 5], 1, -1);
    expect ValidVacuumCommand("clean_rooms", [5, 3], [3, 5], 3, 3);
    expect !ValidVacuumCommand("clean_rooms", [], [3, 5], 1, -1);
    expect !ValidVacuumCommand("clean_rooms", [7], [3, 5], 1, -1);
    expect !ValidVacuumCommand("clean_rooms", [3, 3], [3, 5], 1, -1);
    expect !ValidVacuumCommand("clean_rooms", [3], [3, 5], 0, -1);
    expect !ValidVacuumCommand("clean_rooms", [3], [3, 5], 4, -1);
    expect !ValidVacuumCommand("clean_rooms", [3], [3, 5], 1, 4);
    expect !ValidVacuumCommand("clean_rooms", [3], [3, 5], 1, -2);
    expect VacuumAction("empty_dustbin") && VacuumAction("clean_zones") && VacuumAction("clean_spot");
    expect ValidVacuumCommand("wash_mops", [], [], 0, -1) && ValidVacuumCommand("stop_drying", [], [], 0, -1);
    expect !ValidVacuumCommand("clean_zones", [], [], 0, -1);
    expect ValidVacuumZones([(0, 0, 1000, 1000)], (-5000, -5000, 5000, 5000), 1, -1);
    expect ValidVacuumZones([(0, 0, 1000, 1000), (2000, 2000, 2600, 3000)], (-5000, -5000, 5000, 5000), 3, 2);
    expect !ValidVacuumZones([], (-5000, -5000, 5000, 5000), 1, -1);
    expect !ValidVacuumZones([(0, 0, 1000, 1000)], (100, 100, 5000, 5000), 1, -1);
    expect !ValidVacuumZones([(1000, 0, 0, 1000)], (-5000, -5000, 5000, 5000), 1, -1);
    expect !ValidVacuumZones([(0, 0, 100, 1000)], (-5000, -5000, 5000, 5000), 1, -1);
    expect !ValidVacuumZones([(0, 0, 1000, 1000)], (-5000, -5000, 5000, 5000), 4, -1);
    expect !ValidVacuumZones([(0,0,1000,1000),(0,0,1000,1000),(0,0,1000,1000),(0,0,1000,1000),(0,0,1000,1000),(0,0,1000,1000)], (-5000, -5000, 5000, 5000), 1, -1);
    expect ValidVacuumSpot(100, -200, (-5000, -5000, 5000, 5000), 1, -1);
    expect !ValidVacuumSpot(6000, 0, (-5000, -5000, 5000, 5000), 1, -1);
    expect !ValidVacuumSpot(0, 0, (-5000, -5000, 5000, 5000), 0, -1);
    expect ValidVacuumSetting("cleaning_mode", 3, 0, []);
    expect !ValidVacuumSetting("cleaning_mode", 4, 0, []);
    expect ValidVacuumSetting("volume", 0, 0, []) && ValidVacuumSetting("volume", 100, 0, []);
    expect !ValidVacuumSetting("volume", 101, 0, []);
    expect ValidVacuumSetting("dnd_start", 1439, 0, []) && !ValidVacuumSetting("dnd_start", 1440, 0, []);
    expect ValidVacuumSetting("child_lock", 1, 0, []) && !ValidVacuumSetting("child_lock", 2, 0, []);
    expect !ValidVacuumSetting("firmware", 1, 0, []);
    expect !ValidVacuumSetting("volume", 50, 3, [3]);
    expect ValidVacuumSetting("room_suction", 3, 3, [3, 5]);
    expect !ValidVacuumSetting("room_suction", 3, 9, [3, 5]);
    expect !ValidVacuumSetting("room_suction", 3, 0, [3, 5]);
    expect ValidVacuumSetting("room_passes", 3, 5, [3, 5]) && !ValidVacuumSetting("room_passes", 0, 5, [3, 5]);
    expect VacuumSettingNeedsRoom("room_wetness") && !VacuumSettingNeedsRoom("suction");
    expect ValidVacuumHistoryLimit(1) && ValidVacuumHistoryLimit(20);
    expect !ValidVacuumHistoryLimit(0) && !ValidVacuumHistoryLimit(21);
    expect VacuumTargetsMatch("clean_zones", 0, 2, false) && VacuumTargetsMatch("clean_spot", 0, 0, true);
    expect VacuumTargetsMatch("clean_rooms", 2, 0, false) && VacuumTargetsMatch("dock", 0, 0, false);
    expect !VacuumTargetsMatch("clean_zones", 1, 2, false) && !VacuumTargetsMatch("clean_spot", 0, 0, false);
    expect !VacuumTargetsMatch("dock", 0, 1, false) && !VacuumTargetsMatch("start", 0, 0, true);
    expect ValidVacuumMove(0, 200) && ValidVacuumMove(-360, 0) && ValidVacuumMove(90, -600);
    expect !ValidVacuumMove(0, 0) && !ValidVacuumMove(361, 0) && !ValidVacuumMove(0, 601) && !ValidVacuumMove(0, -601);
    expect ValidVacuumObstacle(3, [1, 3]) && !ValidVacuumObstacle(2, [1, 3]) && !ValidVacuumObstacle(0, [0]);
    expect VacuumAction("go_to") && VacuumNeedsMap("go_to");
    expect VacuumTargetsMatch("go_to", 0, 0, true) && !VacuumTargetsMatch("go_to", 0, 0, false) && !VacuumTargetsMatch("go_to", 1, 0, true);
    expect ValidVacuumGoTo(100, -200, (-5000, -5000, 5000, 5000), 0, -1);
    expect !ValidVacuumGoTo(9000, 0, (-5000, -5000, 5000, 5000), 0, -1);
    expect !ValidVacuumGoTo(0, 0, (-5000, -5000, 5000, 5000), 1, -1) && !ValidVacuumGoTo(0, 0, (-5000, -5000, 5000, 5000), 0, 2);
    expect ValidVacuumShortcut("start", 32, [32, 40], 0) && ValidVacuumShortcut("delete", 40, [32, 40], 0);
    expect ValidVacuumShortcut("rename", 32, [32], 12) && !ValidVacuumShortcut("rename", 32, [32], 0) && !ValidVacuumShortcut("rename", 32, [32], 33);
    expect !ValidVacuumShortcut("start", 33, [32], 0) && !ValidVacuumShortcut("start", 32, [32], 5);
    expect !ValidVacuumShortcut("edit", 32, [32], 0);
    // (name, lowest, highest, step, allowed); allowed empty means any step in the range.
    expect ValidVacuumOption("carpet_boost", 1, [("carpet_boost", 0, 1, 1, [0, 1])]);
    expect !ValidVacuumOption("carpet_boost", 2, [("carpet_boost", 0, 1, 1, [0, 1])]);
    expect ValidVacuumOption("stain_avoidance", 2, [("stain_avoidance", 1, 2, 1, [1, 2])]);
    expect !ValidVacuumOption("stain_avoidance", 0, [("stain_avoidance", 1, 2, 1, [1, 2])]);
    expect ValidVacuumOption("mop_cleaning_remainder", 45, [("mop_cleaning_remainder", 0, 180, 15, [])]);
    expect !ValidVacuumOption("mop_cleaning_remainder", 40, [("mop_cleaning_remainder", 0, 180, 15, [])]);
    expect !ValidVacuumOption("mop_cleaning_remainder", 195, [("mop_cleaning_remainder", 0, 180, 15, [])]);
    expect !ValidVacuumOption("firmware", 1, [("carpet_boost", 0, 1, 1, [0, 1])]);
    expect !ValidVacuumOption("broken", 0, [("broken", 0, 10, 0, [])]);
    expect ValidVacuumButton("reset_filter", ["reset_filter", "start_mapping"]);
    expect !ValidVacuumButton("factory_reset", ["reset_filter", "start_mapping"]);
    expect ValidVacuumMapAction("select", 2, [1, 2], 0, 0, 0) && !ValidVacuumMapAction("select", 3, [1, 2], 0, 0, 0);
    expect ValidVacuumMapAction("rename", 1, [1], 8, 0, 0) && !ValidVacuumMapAction("rename", 1, [1], 0, 0, 0);
    expect ValidVacuumMapAction("restore", 1, [1], 0, 2, 3) && !ValidVacuumMapAction("restore", 1, [1], 0, 4, 3) && !ValidVacuumMapAction("restore", 1, [1], 0, 0, 3);
    expect ValidVacuumMapAction("request", 0, [1], 0, 0, 0) && !ValidVacuumMapAction("request", 1, [1], 0, 0, 0);
    expect ValidVacuumMapAction("save_temporary", 0, [], 0, 0, 0) && ValidVacuumMapAction("replace_temporary", 1, [1], 0, 0, 0);
    expect !ValidVacuumMapAction("wipe", 1, [1], 0, 0, 0) && !ValidVacuumMapAction("delete", 1, [1], 3, 0, 0);
    expect ValidVacuumRoomAction("rename", [3], [3, 5], 6, 0, [0, 1], false) && !ValidVacuumRoomAction("rename", [9], [3, 5], 6, 0, [0, 1], false);
    expect ValidVacuumRoomAction("set_type", [3], [3], 0, 1, [0, 1], false) && !ValidVacuumRoomAction("set_type", [3], [3], 0, 7, [0, 1], false);
    expect ValidVacuumRoomAction("merge", [3, 5], [3, 5], 0, 0, [], false) && !ValidVacuumRoomAction("merge", [3, 3], [3, 5], 0, 0, [], false);
    expect ValidVacuumRoomAction("split", [3], [3, 5], 0, 0, [], true) && !ValidVacuumRoomAction("split", [3, 5], [3, 5], 0, 0, [], true);
    expect ValidVacuumRoomAction("order", [5, 3], [3, 5], 0, 0, [], false) && ValidVacuumRoomAction("order", [], [3, 5], 0, 0, [], false);
    expect !ValidVacuumRoomAction("order", [5], [3, 5], 0, 0, [], false) && !ValidVacuumRoomAction("order", [5, 5], [3, 5], 0, 0, [], false);
    expect ValidVacuumRoomAction("hide", [5], [3, 5], 0, 0, [], false) && ValidVacuumRoomAction("hide", [], [3, 5], 0, 0, [], false);
    expect !ValidVacuumRoomAction("hide", [7], [3, 5], 0, 0, [], false) && !ValidVacuumRoomAction("delete", [3], [3], 0, 0, [], false);
    expect !ValidVacuumRoomAction("split", [3], [3, 5], 0, 0, [], false) && !ValidVacuumRoomAction("merge", [3, 5], [3, 5], 0, 0, [], true);
    expect ValidVacuumLine((0, 0, 1000, 0), (-5000, -5000, 5000, 5000)) && !ValidVacuumLine((0, 0, 0, 0), (-5000, -5000, 5000, 5000));
    expect !ValidVacuumLine((0, 0, 9000, 0), (-5000, -5000, 5000, 5000));
    expect ValidVacuumRoomOption(3, [3], "mop_pressure", 2, [("mop_pressure", 0, 0, 0, [1, 2, 3])]);
    expect !ValidVacuumRoomOption(4, [3], "mop_pressure", 2, [("mop_pressure", 0, 0, 0, [1, 2, 3])]);
    expect ValidVacuumMapEdit("no_go_zones", [(0, 0, 1000, 1000)], (-5000, -5000, 5000, 5000));
    expect ValidVacuumMapEdit("no_go_zones", [], (-5000, -5000, 5000, 5000));
    expect !ValidVacuumMapEdit("no_go_zones", [(1000, 0, 0, 1000)], (-5000, -5000, 5000, 5000));
    expect !ValidVacuumMapEdit("no_go_zones", [(0, 0, 9000, 1000)], (-5000, -5000, 5000, 5000));
    expect ValidVacuumMapEdit("virtual_walls", [(0, 0, 1000, 0)], (-5000, -5000, 5000, 5000));
    expect !ValidVacuumMapEdit("virtual_walls", [(5, 5, 5, 5)], (-5000, -5000, 5000, 5000));
    expect ValidVacuumMapEdit("predefined_points", [(10, 20, 10, 20)], (-5000, -5000, 5000, 5000));
    expect !ValidVacuumMapEdit("predefined_points", [(10, 20, 30, 20)], (-5000, -5000, 5000, 5000));
    expect ValidVacuumMapEdit("router_position", [(10, 20, 10, 20)], (-5000, -5000, 5000, 5000));
    expect !ValidVacuumMapEdit("router_position", [], (-5000, -5000, 5000, 5000));
    expect !ValidVacuumMapEdit("furniture", [(0, 0, 10, 10)], (-5000, -5000, 5000, 5000));
    expect ValidVacuumPath([(0, 0), (100, 100)], (-5000, -5000, 5000, 5000));
    expect !ValidVacuumPath([], (-5000, -5000, 5000, 5000)) && !ValidVacuumPath([(0, 9000)], (-5000, -5000, 5000, 5000));
    expect VacuumJobFinished("sweeping", "charging") && VacuumJobFinished("washing", "drying");
    expect VacuumJobFinished("returning", "charging_completed") && VacuumJobFinished("sweeping_and_mopping", "idle");
    expect !VacuumJobFinished("washing", "mopping") && !VacuumJobFinished("charging", "charging");
    expect !VacuumJobFinished("idle", "charging") && !VacuumJobFinished("sweeping", "returning_to_wash");
    expect VacuumNewError("", "wheel_stuck") && !VacuumNewError("wheel_stuck", "wheel_stuck") && !VacuumNewError("x", "");
    expect VacuumPartWorn(12, 9, 10) && !VacuumPartWorn(9, 8, 10) && !VacuumPartWorn(50, 40, 10);
    print "Dafny core executable tests passed\n";
  }
}
