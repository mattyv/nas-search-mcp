# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
NAS_TOKEN=
# Confirm these paths in DSM; defaults assume Volume 1.
NAS_DOCUMENTS_PATH=/volume1/shared-documents
NAS_DOCUMENTS_LABEL=Documents
NAS_CODE_PATH=/volume1/shared-code
NAS_PHOTOS_PATH=/volume1/shared-photos
NAS_INDEX_PATH=/volume1/app-data/nas-search/index
# DSM user numeric UID/GID; grant this user write access to NAS_INDEX_PATH.
NAS_UID=1000
NAS_GID=1000
# Private MCP bind address. Use a verified NAS LAN address for LAN access.
# The NAS installer also retains loopback for Tailscale Serve when using LAN.
NAS_BIND_IP=127.0.0.1
# Enable after measuring a small pilot's memory use.
NAS_PHOTOS=false
NAS_OCR=true
# CPU affinity works without CFS quota support on Synology. 0-1 uses both cores; 0 pins one core.
NAS_CPUSET=0-1
# Lower shares give DSM priority under contention (Docker default is 1024).
NAS_CPU_SHARES=512

# Keep the embedding model loaded for this many idle minutes; 0 disables reuse.
NAS_MODEL_KEEPALIVE_MINUTES=5
# Replace the worker process after an extraction once its peak memory passes this many MiB.
NAS_WORKER_MAX_RSS_MIB=600
# Pause between eligible files in each scan to reduce disk contention on small NAS devices.
# 2 seconds adds about 5.5 hours per 10,000 files; 0 disables pacing.
NAS_SCAN_FILE_DELAY_SECONDS=2
# OAuth connector: disabled until a public HTTPS issuer and password hash are set.
# Create .env as root, chmod 600, and single-quote bcrypt hashes to preserve $.
NAS_OAUTH_ISSUER=
NAS_OAUTH_CLIENT_ID=nas-claude
NAS_OAUTH_PASSWORD_HASH=
# Optional confidential client; leave empty for Claude's public PKCE client.
NAS_OAUTH_CLIENT_SECRET_HASH=
# Empty denies access to all folders; paths are relative to /files.
# Example: Documents,Code,Photos (include only folders you intend to expose).
NAS_ALLOWED_FOLDERS=
NAS_DENIED_FOLDERS=
# Optional browser uploads: create Documents/Uploads first, give the container
# user write access only there, then set both fields in the private NAS .env.
# The installer adds a separate writable mount; the Documents source stays read-only.
NAS_UPLOAD_ENABLED=false
NAS_UPLOAD_PATH=
# Optional: allow the assistant to propose any existing folder under the
# configured searchable sources. A separate writer gets writable source mounts;
# search stays read-only. NAS_UPLOAD_PATH is not used in this mode.
NAS_UPLOAD_INDEXED_DESTINATIONS=false
# Inspector testing only: exact loopback callback URLs; leave empty in production.
NAS_OAUTH_LOCAL_REDIRECTS=
# Optional ChatGPT plugin: exact callback URL displayed by ChatGPT for this server.
# Keep the value in the private deployment .env, not in source control.
NAS_OAUTH_CHATGPT_REDIRECT=
# Download links let Claude hand you a tap-to-open link for an original file.
# Empty uses NAS_OAUTH_ISSUER; set both empty to turn links off. Lifetime: 1-60 minutes.
NAS_DOWNLOAD_URL=
NAS_DOWNLOAD_LINK_MINUTES=10

# Optional MCP upgrades: use scripts/enable-upgrades.py on the NAS first.
# Leave disabled until the protected host worker and boot task are installed.
NAS_UPGRADE_DIR=
# The enablement script sets NAS_UPGRADE_PATH to its protected queue.

# Shared memory (optional, off by default). Guide: docs/memory.md
NAS_MEMORY_ENABLED=false
# Folder for the memory database; outside sources, index, and upgrade folders. The installer creates it.
NAS_MEMORY_PATH=/volume1/app-data/nas-search/memory
# Your Tailscale login, the only person who may open the editor.
NAS_EDITOR_OWNER=
# Private editor address from tailscale serve: https://NAS_NAME.TAILNET.ts.net:8444
NAS_EDITOR_ORIGIN=
# Local editor port (1024-65535); only the NAS itself listens on it.
NAS_EDITOR_PORT=8083
# Scopes the assistant may use, comma-separated; use / for sub-scopes (personal,work/acme).
NAS_MEMORY_SCOPES=personal
# Sign-in passkeys: off, enroll, or required.
NAS_OAUTH_PASSKEYS=enroll
# Optional Jev classifier from TypeSafe; leave the key empty to turn it off.
NAS_JEV_API_KEY=
# Only notes in these scopes are sent to TypeSafe.
NAS_JEV_SCOPES=personal
# Score cutoffs from 0 to 1000: accept at or above, reject at or below (0 <= reject < accept <= 1000).
NAS_MEMORY_ACCEPT_AT=900
NAS_MEMORY_REJECT_AT=100
