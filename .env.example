# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
NAS_TOKEN=
# Confirm these paths in DSM; defaults assume Volume 1.
NAS_MATTHEW_PATH=/volume1/Matthew
NAS_PHOTOS_PATH=/volume1/homes/matt/Photos
NAS_INDEX_PATH=/volume1/docker/nas-search/data
# DSM user numeric UID/GID; grant this user write access to NAS_INDEX_PATH.
NAS_UID=1026
NAS_GID=100
# Use 192.168.1.4 for the local LAN, the NAS Tailscale IP for remote clients,
# or loopback with a reverse proxy. Loopback is the safe initial default.
NAS_BIND_IP=127.0.0.1
# Enable after measuring a small pilot's memory use.
NAS_PHOTOS=false
